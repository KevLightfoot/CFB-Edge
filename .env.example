# Copy this file to ".env" (same folder) and fill in your keys.
# .env is in .gitignore, so it never goes to GitHub.
# On Render, set these same names under Environment instead.

CFBD_API_KEY=your-collegefootballdata-key
OPENAI_API_KEY=your-openai-key

# Optional
OPENAI_MODEL=gpt-4o-mini
APP_PASSWORD=
