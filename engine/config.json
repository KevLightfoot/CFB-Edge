{
  "_readme": "Every tunable setting lives here. Change values, re-run run_week.py --retrain, and compare the new report card. Keys starting with _ are comments.",

  "data": {
    "_note": "Seasons used to train the final model. 2020 (COVID) is skipped by default because schedules and home field were unusual.",
    "train_seasons": [2018, 2019, 2021, 2022, 2023, 2024, 2025],
    "backtest_seasons": [2023, 2024, 2025],
    "include_current_season_in_training": true,
    "season_type": "regular",
    "fbs_only": true,
    "line_provider_preference": ["DraftKings", "ESPN Bet", "Bovada", "consensus", "William Hill (New Jersey)"],
    "current_season_cache_hours": 6
  },

  "features": {
    "_note": "Team stats are season-to-date averages from games BEFORE the game being predicted. Early in the season they are blended with last season's numbers: weight = games / (games + prior_games_weight).",
    "prior_games_weight": 3,

    "margin_features": [
      "elo_diff",
      "talent_diff",
      "net_ppa_diff",
      "net_success_diff",
      "net_explosiveness_diff",
      "rush_matchup",
      "pass_matchup",
      "net_havoc_diff",
      "net_points_diff",
      "home_field"
    ],

    "total_features": [
      "off_ppa_sum",
      "def_ppa_sum",
      "pace_sum",
      "points_for_sum",
      "points_against_sum",
      "explosiveness_sum"
    ],

    "volatility_features": [
      "expected_total",
      "pace_sum",
      "havoc_allowed_sum",
      "abs_expected_margin",
      "abs_talent_gap"
    ],

    "labels": {
      "elo_diff": "Elo rating gap",
      "talent_diff": "Roster talent gap",
      "net_ppa_diff": "Net EPA per play gap",
      "net_success_diff": "Net success rate gap",
      "net_explosiveness_diff": "Net explosiveness gap",
      "rush_matchup": "Run game matchup",
      "pass_matchup": "Pass game matchup",
      "net_havoc_diff": "Havoc (disruption) gap",
      "net_points_diff": "Scoring margin gap",
      "home_field": "Home field",
      "off_ppa_sum": "Combined offensive EPA",
      "def_ppa_sum": "Combined defensive EPA allowed",
      "pace_sum": "Combined pace (plays/game)",
      "points_for_sum": "Combined points scored",
      "points_against_sum": "Combined points allowed",
      "explosiveness_sum": "Combined explosiveness",
      "expected_total": "Expected total points",
      "havoc_allowed_sum": "Turnover/disruption proneness",
      "abs_expected_margin": "Size of expected margin",
      "abs_talent_gap": "Size of talent gap"
    }
  },

  "model": {
    "_note": "ridge_alpha: higher = more conservative weights. market_blend: 0 = pure model, 1 = pure Vegas line. sigma bounds clamp the per-game volatility.",
    "ridge_alpha": 10.0,
    "market_blend": 0.75,
    "use_market_total_for_volatility": true,
    "sigma_min": 11.0,
    "sigma_max": 22.0,
    "default_sigma": 16.0
  },

  "betting": {
    "_note": "Thresholds used by the report card to simulate bets and by the site to highlight edges.",
    "blowout_margins": [17.5, 21.5],
    "alt_dog_spread_range": [2.0, 7.0],
    "spread_edge_threshold_pts": 3.0,
    "ml_edge_threshold": 0.04,
    "remove_vig": true
  }
}
